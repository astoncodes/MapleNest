# MapleNest environment configuration
# Copy to .env and fill in values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# SECURITY: only ever use the *anon public* key here. Everything prefixed
# VITE_ is inlined into the public JavaScript bundle at build time. The
# service_role key must never appear in this file, in Vercel env vars for
# this app, or anywhere else client-side — it bypasses Row Level Security.

# Your Supabase project URL, e.g. https://abcdefghij.supabase.co
VITE_SUPABASE_URL=

# The anon (public) API key — labelled "anon public" in the dashboard.
# The app refuses to start if a service_role key is pasted here.
VITE_SUPABASE_ANON_KEY=
